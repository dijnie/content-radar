# Copy to apps/worker/.dev.vars for local development. Never commit real values.
DEEPSEEK_API_KEY=
# To use the remote AI binding locally instead of the direct key, uncomment:
# AI_GATEWAY_ID=gateway
# Gateway needs a DeepSeek key named default and Require provider credentials enabled.
GITHUB_TOKEN=
OWNER_EMAIL=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Must equal the origin you open in the browser, e.g. http://127.0.0.1:8787 for `npm run dev`;
# the CSRF guard compares it with the Origin header even when the dev auth bypass is on.
APP_ORIGIN=

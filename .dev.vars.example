# Copy to apps/worker/.dev.vars for local development. Never commit real values.
# OpenAI-compatible API base URL (e.g. https://your-provider.example/v1)
# or full chat/completions URL. Fill all three fields to enable AI calls.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
GITHUB_TOKEN=
OWNER_EMAIL=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Must equal the origin you open in the browser, e.g. http://127.0.0.1:8787 for `npm run dev`;
# the CSRF guard compares it with the Origin header even when the dev auth bypass is on.
APP_ORIGIN=

# Copy to .env.setup at the repository root, fill in, then run npm run setup.
# In Cloudflare Builds, enter these names under Build variables and secrets.
# Environment variables override this file. This file contains no API keys.

# Required: the account and EXISTING D1 database used by this deployment.
# Find the account ID in Cloudflare; find the database UUID in D1 > database > Settings.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=

# Names of existing resources in the account above (defaults shown).
# WORKER_NAME must match the Worker connected to Cloudflare Builds.
WORKER_NAME=content-radar
D1_DATABASE_NAME=content-radar
R2_BUCKET_NAME=content-radar-raw
POLL_QUEUE_NAME=radar-poll
LLM_QUEUE_NAME=radar-llm
DLQ_QUEUE_NAME=radar-dlq

# Fill BOTH fields to enable LLM processing; leave BOTH empty to pause it.
# Endpoint example: https://your-provider.example/v1
LLM_ENDPOINT=
LLM_MODEL=

# Runtime secrets are configured separately in Worker > Settings > Variables and Secrets:
# LLM_API_KEY, GITHUB_TOKEN, OWNER_EMAIL, ACCESS_TEAM_DOMAIN, ACCESS_AUD, APP_ORIGIN.
# See docs/setup.md. Do not put secret values in this template.

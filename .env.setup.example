# OPTIONAL overrides for local CLI setup or Cloudflare Build variables.
# Cloudflare Builds needs no .env.setup file and no D1_DATABASE_ID.
# In Worker > Bindings, attach the existing D1 database with variable name DB.
# Wrangler reuses that binding on deploy, regardless of the database's actual name.

# Account selection is automatic in Cloudflare Builds. For local CLI only:
# CLOUDFLARE_ACCOUNT_ID=

# Names of existing resources (defaults shown).
# WORKER_NAME must match the Worker connected to Cloudflare Builds.
WORKER_NAME=content-radar
R2_BUCKET_NAME=content-radar-raw
POLL_QUEUE_NAME=radar-poll
LLM_QUEUE_NAME=radar-llm
DLQ_QUEUE_NAME=radar-dlq

# Configure LLM_ENDPOINT and LLM_MODEL in Worker > Settings > Variables and Secrets.
# Omit both here to keep the dashboard values on deployment (the default).
# Uncomment and fill BOTH to override them, or set BOTH empty to pause LLM work.
# LLM_ENDPOINT=https://your-provider.example/v1
# LLM_MODEL=your-model-id

# Only for explicit D1 CLI operations (migrations, config:sync --remote, reports).
# Set to the actual database selected in Worker > Bindings, then use:
# npm run setup -- --database
# D1_DATABASE_NAME=content-radar

# Runtime secrets stay in Worker > Settings > Variables and Secrets:
# LLM_API_KEY, GITHUB_TOKEN, OWNER_EMAIL, ACCESS_TEAM_DOMAIN, ACCESS_AUD, APP_ORIGIN.
# See docs/setup.md. Do not put secret values in this template.

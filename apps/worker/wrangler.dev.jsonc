// Local development only (`npm run dev`). The auth bypass constant is true
// here and nowhere else; this file declares no route, so it is never deployed.
// Keep bindings in step with wrangler.jsonc.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "content-radar-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "define": { "__DEV_AUTH_BYPASS__": "true" },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-radar",
      "database_id": "05658112-1927-432e-b475-4aa0cca291e6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "content-radar-raw" }],
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [
      { "binding": "POLL_QUEUE", "queue": "radar-poll" },
      { "binding": "LLM_QUEUE", "queue": "radar-llm" }
    ],
    "consumers": [
      // One poll at a time: sources are community services and must not be hit in a burst.
      { "queue": "radar-poll", "max_batch_size": 10, "max_concurrency": 1, "max_retries": 5, "dead_letter_queue": "radar-dlq" },
      { "queue": "radar-llm", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "radar-dlq" }
    ]
  },
  "triggers": { "crons": ["*/30 * * * *", "5 * * * *", "20 8 * * *"] }
}

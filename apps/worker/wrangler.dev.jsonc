// Local development only (`npm run dev`); this file declares no deployed route.
// Deployment defaults are in the repository's root wrangler.json.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "content-radar-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-radar",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "content-radar-raw" }],
  "queues": {
    "producers": [
      { "binding": "POLL_QUEUE", "queue": "radar-poll" },
      { "binding": "LLM_QUEUE", "queue": "radar-llm" }
    ],
    "consumers": [
      // One poll at a time: sources are community services and must not be hit in a burst.
      { "queue": "radar-poll", "max_batch_size": 10, "max_concurrency": 1, "max_retries": 5, "dead_letter_queue": "radar-dlq" },
      // A single consumer, so reading the budget and reserving from it never races.
      {
        "queue": "radar-llm",
        "max_batch_size": 10,
        "max_batch_timeout": 60,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "radar-dlq"
      },
      { "queue": "radar-dlq", "max_batch_size": 10, "max_concurrency": 1 }
    ]
  },
  "triggers": { "crons": ["*/30 * * * *", "5 * * * *", "20 8 * * *"] }
}

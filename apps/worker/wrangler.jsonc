// Production configuration. Secrets (LLM_API_KEY, GITHUB_TOKEN, OWNER_EMAIL,
// ACCESS_TEAM_DOMAIN, ACCESS_AUD, APP_ORIGIN) are set with `wrangler secret put`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "content-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The production workers.dev hostname is protected by Cloudflare Access.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Set these to your OpenAI-compatible provider before deploying.
    "LLM_ENDPOINT": "",
    "LLM_MODEL": ""
  },
  "define": { "__DEV_AUTH_BYPASS__": "false" },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static assets also pass through the Worker's authentication layer.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-radar",
      "database_id": "05658112-1927-432e-b475-4aa0cca291e6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "content-radar-raw" }],
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [
      { "binding": "POLL_QUEUE", "queue": "radar-poll" },
      { "binding": "LLM_QUEUE", "queue": "radar-llm" }
    ],
    "consumers": [
      // One poll at a time: sources are community services and must not be hit in a burst.
      { "queue": "radar-poll", "max_batch_size": 10, "max_concurrency": 1, "max_retries": 5, "dead_letter_queue": "radar-dlq" },
      // A single consumer, so reading the budget and reserving from it never races.
      {
        "queue": "radar-llm",
        "max_batch_size": 10,
        "max_batch_timeout": 60,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "radar-dlq"
      },
      { "queue": "radar-dlq", "max_batch_size": 10, "max_concurrency": 1 }
    ]
  },
  "triggers": { "crons": ["*/30 * * * *", "5 * * * *", "20 8 * * *"] }
}
